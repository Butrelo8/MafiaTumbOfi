# Canonical site URL, without a trailing slash.
PUBLIC_SITE_URL=https://mafiatumbada.com

# Set false or 0 on preview builds to emit noindex metadata.
PUBLIC_ALLOW_INDEXING=true

# Plausible hostname, without https://. Omit to disable analytics.
PUBLIC_PLAUSIBLE_DOMAIN=mafiatumbada.com

# Build-only Spotify catalog credentials. Never expose as PUBLIC_ variables.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
