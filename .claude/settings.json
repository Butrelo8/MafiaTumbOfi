{
  "enabledPlugins": {
    "cloudflare@cloudflare": true
  },
  "permissions": {
    "allow": [
      "mcp__chrome-devtools__take_screenshot",
      "Bash(ffprobe *)",
      "Bash(git check-ignore *)",
      "Bash(/mnt/c/Windows/System32/netstat.exe *)",
      "mcp__blender__get_objects_summary",
      "mcp__comfy-mcp__server_info",
      "mcp__browsermcp__browser_screenshot",
      "mcp__blender__get_blendfile_summary_path_info",
      "mcp__blender__search_manual_docs",
      "mcp__browsermcp__browser_snapshot",
      "Bash(/mnt/c/Windows/System32/tasklist.exe *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/bash-guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
