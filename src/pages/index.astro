---
import MarketingLayout from '../layouts/MarketingLayout.astro'
import AltarScene from '../components/AltarScene.astro'
import ArtworkShelf from '../components/ArtworkShelf.astro'
import Eyebrow from '../components/Eyebrow.astro'
import FilmStrip from '../components/FilmStrip.astro'
import MemberCard from '../components/MemberCard.astro'
import { members } from '../data/members'
import { bandSocialUrls } from '../data/socials'
import { loadCatalog } from '../lib/catalog'
import { homeCanonical } from '../lib/publicSiteUrl'

const title = 'Mafia Tumbada — Oficial'
const description = 'Sitio oficial de Mafia Tumbada. Música, videos, integrantes y contacto para contrataciones desde Xalapa, Veracruz.'
const canonicalUrl = homeCanonical(import.meta.env.PUBLIC_SITE_URL, Astro.url.origin)
const catalog = await loadCatalog()
const releases = catalog.releases.map((release) => ({
  ...release,
  subtitle: /^\d{4}$/.test(release.subtitle ?? '') ? release.subtitle : undefined,
}))
---

<MarketingLayout title={title} description={description} canonicalUrl={canonicalUrl} hasHero={true}>
  <AltarScene />

  <section class="hero hero--asymmetric" id="inicio" aria-labelledby="hero-heading" data-estacion="0">
    <!-- Sale de scripts/build-hero.sh. Vertical en pantallas altas, como la escena. -->
    <video class="hero-video" muted playsinline loop preload="metadata" poster="/video/hero-poster.jpg" aria-hidden="true" data-hero-video>
      <source media="(max-aspect-ratio: 1/1)" src="/video/hero-v.av1.mp4" type='video/mp4; codecs="av01.0.08M.10"' />
      <source media="(max-aspect-ratio: 1/1)" src="/video/hero-v.mp4" type="video/mp4" />
      <source src="/video/hero.av1.mp4" type='video/mp4; codecs="av01.0.08M.10"' />
      <source src="/video/hero.mp4" type="video/mp4" />
    </video>
    <div class="container hero-grid"><div class="hero-copy hero-content">
      <p class="hero-eyebrow">Sitio Oficial</p>
      <h1 id="hero-heading" class="hero-title"><img src="/icon/mafiatumbada.webp" alt="Mafia Tumbada" class="hero-logo-img" width="397" height="264" fetchpriority="high" loading="eager" /></h1>
      <div class="hero-meta"><span>Xalapa, Veracruz</span><span>Corridos Tumbados</span><span>Desde 2021</span></div>
      <div class="hero-actions"><a href={bandSocialUrls.whatsapp} target="_blank" rel="noopener noreferrer" class="btn-primary" data-plausible-event="whatsapp_hero">Escríbenos por WhatsApp</a></div>
    </div></div>
  </section>

  <div class="tramo-espacio" aria-hidden="true"></div>

  <section class="estacion bio-section" id="quienes" aria-labelledby="bio-heading">
    <div class="estacion-titular" data-estacion="1"><div class="container">
      <Eyebrow text="Quiénes somos" />
      <h2 id="bio-heading">El sonido de <em>Xalapa</em></h2>
    </div></div>
    <div class="estacion-panel"><div class="container bio-grid">
      <div class="bio-tags">{['Corridos Tumbados', 'Norteño', 'Regional Mx', 'Covers', 'Canciones propias'].map((tag) => <span class="tag">{tag}</span>)}</div>
      <div class="bio-body">
        <p class="bio-lede">La Mafia Tumbada es un grupo de corridos tumbados y regional mexicano con base en Xalapa, Veracruz. Canciones propias, covers con actitud y cuatro años de tarima.</p>
        <p>La Mafia Tumbada es un grupo de Xalapa, Veracruz que lleva cuatro años construyendo su propio espacio dentro del regional mexicano contemporáneo. Con raíces en el corrido tumbado y el norteño, y sin perder el pulso del regional clásico, el grupo mezcla canciones propias con covers ejecutados con honestidad y actitud.</p>
        <p>Un catálogo de singles originales es la muestra de un proyecto que toma en serio la composición propia. Al mismo tiempo, su versatilidad en tarima los ha llevado a barras y escenarios tanto en Veracruz como fuera del estado.</p>
      </div>
    </div></div>
  </section>

  <div class="tramo-espacio" aria-hidden="true"></div>

  <section class="estacion music-section" id="musica" aria-labelledby="musica-heading">
    <div class="estacion-titular" data-estacion="2"><div class="container">
      <Eyebrow text="Escucha" />
      <h2 id="musica-heading" class="gold-text">Música</h2>
    </div></div>
    <div class="estacion-panel"><div class="container">
      <ArtworkShelf items={releases} />
      <a class="music-link" href={bandSocialUrls.appleMusic} target="_blank" rel="noopener noreferrer">Escúchanos en Apple Music</a>
      <h3 class="videos-heading">Videos</h3>
      <ul class="video-row">{catalog.videos.map((video) => <li><a href={video.href} target="_blank" rel="noopener noreferrer"><img src={video.thumbnail} alt="" width="480" height="360" loading="lazy" decoding="async" /><span>{video.title}</span></a></li>)}</ul>
    </div><FilmStrip /></div>
  </section>

  <div class="tramo-espacio" aria-hidden="true"></div>

  <section class="estacion group-section" id="grupo" aria-labelledby="grupo-heading">
    <div class="estacion-titular" data-estacion="3"><div class="container">
      <Eyebrow text="La banda" />
      <h2 id="grupo-heading" class="gold-text">El grupo</h2>
    </div></div>
    <div class="estacion-panel"><div class="container">
      <div class="members-grid">{members.map((member) => <MemberCard {...member} />)}</div>
    </div></div>
  </section>

  <div class="tramo-espacio" aria-hidden="true"></div>

  <section class="estacion booking-section" id="contratacion" aria-labelledby="contratacion-heading">
    <div class="estacion-titular" data-estacion="4"><div class="container">
      <Eyebrow text="Contratar al grupo" />
      <h2 id="contratacion-heading" class="gold-text">¿Tienes una <em>fecha disponible?</em></h2>
    </div></div>
    <div class="estacion-panel"><div class="container booking-copy">
      <p>El grupo está disponible para presentaciones, festivales, eventos privados y giras regionales. Cuentan con equipo propio y experiencia para adaptarse a diferentes formatos de producción.</p>
      <p class="booking-urgency">Agenda limitada — los fines de semana suelen reservarse con tres o cuatro semanas de anticipación.</p>
      <a href={bandSocialUrls.whatsapp} target="_blank" rel="noopener noreferrer" class="btn-primary" data-plausible-event="whatsapp_contratacion">Escríbenos por WhatsApp</a>
      <p>O llámanos: <a href="tel:+522283538827">+52 228 353 8827</a></p>
    </div></div>
  </section>

  <div class="tramo-espacio" aria-hidden="true"></div>

  <footer class="estacion footer-bar" id="cierre">
    <div class="estacion-titular" data-estacion="5"><div class="container">
      <p class="footer-monograma gold-text" aria-hidden="true"><span>M</span><svg class="header-mark-bolt" viewBox="0 0 46 86" focusable="false"><path d="M28 2L6 48h14L16 84l24-48H26L28 2z" fill="currentColor" /></svg><span>T</span></p>
    </div></div>
    <div class="estacion-panel"><div class="container">
    <span class="footer-brand gold-text">Mafia Tumbada</span>
    <div class="footer-socials">
      <a href={bandSocialUrls.spotify} target="_blank" rel="noopener noreferrer">Spotify</a><a href={bandSocialUrls.appleMusic} target="_blank" rel="noopener noreferrer">Apple Music</a><a href={bandSocialUrls.instagram} target="_blank" rel="noopener noreferrer">Instagram</a><a href={bandSocialUrls.tiktok} target="_blank" rel="noopener noreferrer">TikTok</a><a href={bandSocialUrls.youtube} target="_blank" rel="noopener noreferrer">YouTube</a><a href={bandSocialUrls.whatsapp} target="_blank" rel="noopener noreferrer" data-plausible-event="whatsapp_footer">WhatsApp</a>
    </div>
    <p class="footer-copy">© {new Date().getFullYear()} · Xalapa, Veracruz · Todos los derechos reservados</p>
    </div></div>
  </footer>
</MarketingLayout>

<script>
  import { trackPlausible } from '../lib/plausibleClient'
  const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
    if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target) }
  }), { threshold: 0.1, rootMargin: '0px 0px -50px 0px' })
  document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((element) => { element.dataset.reveal = 'oculto'; observer.observe(element) })
  // El hero sólo corre en pantalla y nunca con movimiento reducido: ahí se queda el poster.
  const heroVideo = document.querySelector<HTMLVideoElement>('[data-hero-video]')
  if (heroVideo && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) heroVideo.play().catch(() => {})
      else heroVideo.pause()
    }).observe(heroVideo)
  }
  document.querySelectorAll('[data-plausible-event]').forEach((element) => {
    element.addEventListener('click', () => trackPlausible(element.getAttribute('data-plausible-event') ?? ''))
  })
</script>

<style>
  .hero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  /* Velo medido como el de la escena: percentil 95 de luminancia del video detrás
     del texto contra --text a 4.5:1. Móvil (texto arriba, entre las columnas) pide
     0.44; escritorio (pasillo, abajo) ya pasa sin velo, 0.15 es margen. */
  .hero::after { content: ''; position: absolute; inset: 0; background: rgba(0, 0, 0, 0.45); pointer-events: none; }
  @media (min-aspect-ratio: 1/1) { .hero::after { background: rgba(0, 0, 0, 0.15); } }
  .bio-lede { max-width: 38rem; font-size: clamp(0.95rem, 2vw, 1.1rem); line-height: 1.6; font-weight: 600; opacity: 0.85; margin: 0; }
  .hero-actions, .music-link { margin-top: 2rem; }
  .music-link, .booking-copy a:not(.btn-primary), .footer-socials a { display: inline-flex; align-items: center; min-height: 44px; padding-block: 0.5rem; }
  .videos-heading { margin-top: var(--space-lg); }
  .video-row { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1rem; list-style: none; margin: 1rem 0 0; padding: 0; }
  .video-row a { color: inherit; text-decoration: none; }
  .video-row img { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; margin-bottom: 0.6rem; }
  .video-row span, .music-link, .booking-copy a:not(.btn-primary), .footer-socials a { color: var(--red-link); }
  .booking-copy { display: grid; gap: 1.25rem; align-items: start; justify-items: start; }
  .booking-urgency { font-weight: 600; }
  .members-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin-top: 2rem; }
  .footer-socials { display: flex; flex-wrap: wrap; gap: 1rem; }
</style>
