---
import MarketingLayout from '../layouts/MarketingLayout.astro'
import ArtworkShelf from '../components/ArtworkShelf.astro'
import Eyebrow from '../components/Eyebrow.astro'
import FilmStrip from '../components/FilmStrip.astro'
import Marquee from '../components/Marquee.astro'
import MemberCard from '../components/MemberCard.astro'
import { members } from '../data/members'
import { bandSocialUrls } from '../data/socials'
import { loadCatalog } from '../lib/catalog'
import { homeCanonical } from '../lib/publicSiteUrl'

const title = 'Mafia Tumbada — Oficial'
const description = 'Sitio oficial de Mafia Tumbada. Música, videos, integrantes y contacto para contrataciones desde Xalapa, Veracruz.'
const canonicalUrl = homeCanonical(import.meta.env.PUBLIC_SITE_URL, Astro.url.origin)
const catalog = await loadCatalog()
const releases = catalog.releases.map((release) => ({
  ...release,
  subtitle: /^\d{4}$/.test(release.subtitle ?? '') ? release.subtitle : undefined,
  label: 'Escuchar en Spotify',
}))
---

<MarketingLayout title={title} description={description} canonicalUrl={canonicalUrl} hasHero={true}>
  <section class="hero hero--asymmetric" aria-labelledby="hero-heading">
    <video class="hero-video" muted playsinline loop aria-hidden="true" preload="none"><source data-src="/video/hero.mp4" type="video/mp4" /></video>
    <div class="hero-grain" aria-hidden="true"></div>
    <div class="container hero-grid"><div class="hero-copy hero-content">
      <p class="hero-eyebrow">Sitio Oficial</p>
      <h1 id="hero-heading" class="hero-title"><img src="/icon/mafiatumbada.webp" alt="Mafia Tumbada" class="hero-logo-img" width="397" height="264" fetchpriority="high" loading="eager" /></h1>
      <div class="hero-meta"><span>Xalapa, Veracruz</span><span>Corridos Tumbados</span><span>Regional Mexicano</span><span>Desde 2021</span></div>
      <p class="hero-blurb">La Mafia Tumbada es un grupo de corridos tumbados y regional mexicano con base en Xalapa, Veracruz. Canciones propias, covers con actitud y cuatro años de tarima.</p>
      <div class="hero-actions"><a href={bandSocialUrls.whatsapp} target="_blank" rel="noopener noreferrer" class="btn-primary">Escríbenos por WhatsApp</a></div>
    </div></div>
  </section>

  <Marquee />

  <section class="section music-section" id="musica" aria-labelledby="musica-heading"><div class="container">
    <Eyebrow text="Escucha" />
    <h2 id="musica-heading" class="section-heading">Música</h2>
    <ArtworkShelf items={releases} />
    <a class="music-link" href={bandSocialUrls.appleMusic} target="_blank" rel="noopener noreferrer">Escúchanos en Apple Music</a>
    <h3 class="videos-heading">Videos</h3>
    <ul class="video-row">{catalog.videos.map((video) => <li><a href={video.href} target="_blank" rel="noopener noreferrer"><img src={video.thumbnail} alt="" width="480" height="360" loading="lazy" decoding="async" /><span>{video.title}</span></a></li>)}</ul>
  </div></section>

  <FilmStrip />

  <section class="section bio-section" aria-labelledby="bio-heading"><div class="container bio-grid">
    <div class="bio-sidebar" data-reveal>
      <Eyebrow text="Quiénes somos" />
      <h2 id="bio-heading">El sonido de <em>Xalapa</em></h2>
      <div class="bio-tags">{['Corridos Tumbados', 'Norteño', 'Regional Mx', 'Covers', 'Canciones propias'].map((tag) => <span class="tag">{tag}</span>)}</div>
    </div>
    <div class="bio-body" data-reveal>
      <p>La Mafia Tumbada es un grupo de Xalapa, Veracruz que lleva cuatro años construyendo su propio espacio dentro del regional mexicano contemporáneo. Con raíces en el corrido tumbado y el norteño, y sin perder el pulso del regional clásico, el grupo mezcla canciones propias con covers ejecutados con honestidad y actitud.</p>
      <p>Un catálogo de singles originales es la muestra de un proyecto que toma en serio la composición propia. Al mismo tiempo, su versatilidad en tarima los ha llevado a barras y escenarios tanto en Veracruz como fuera del estado.</p>
    </div>
  </div></section>

  <section class="section group-section" id="grupo" aria-labelledby="grupo-heading"><div class="container">
    <Eyebrow text="La banda" /><h2 id="grupo-heading" class="section-heading">El grupo</h2>
    <div class="members-grid">{members.map((member) => <MemberCard {...member} />)}</div>
  </div></section>

  <section class="section booking-section" id="contratacion" aria-labelledby="contratacion-heading"><div class="container booking-grid">
    <div><Eyebrow text="Contratar al grupo" /><h2 id="contratacion-heading" class="section-heading">¿Tienes una <em>fecha disponible?</em></h2></div>
    <div class="booking-copy">
      <p>El grupo está disponible para presentaciones, festivales, eventos privados y giras regionales. Cuentan con equipo propio y experiencia para adaptarse a diferentes formatos de producción.</p>
      <p class="booking-urgency">Agenda limitada — los fines de semana suelen reservarse con tres o cuatro semanas de anticipación.</p>
      <a href={bandSocialUrls.whatsapp} target="_blank" rel="noopener noreferrer" class="btn-primary">Escríbenos por WhatsApp</a>
      <p>O llámanos: <a href="tel:+522288351464">+52 228 835 1464</a></p>
    </div>
  </div></section>

  <footer class="footer-bar"><div class="container">
    <span class="footer-brand">Mafia Tumbada</span>
    <div class="footer-socials">
      <a href={bandSocialUrls.spotify} target="_blank" rel="noopener noreferrer">Spotify</a><a href={bandSocialUrls.appleMusic} target="_blank" rel="noopener noreferrer">Apple Music</a><a href={bandSocialUrls.instagram} target="_blank" rel="noopener noreferrer">Instagram</a><a href={bandSocialUrls.tiktok} target="_blank" rel="noopener noreferrer">TikTok</a><a href={bandSocialUrls.youtube} target="_blank" rel="noopener noreferrer">YouTube</a><a href={bandSocialUrls.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp</a>
    </div>
    <p class="footer-copy">© {new Date().getFullYear()} · Xalapa, Veracruz · Todos los derechos reservados</p>
  </div></footer>
</MarketingLayout>

<script>
  import { mountHeroVideo } from '../lib/heroVideo'
  const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
    if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target) }
  }), { threshold: 0.1, rootMargin: '0px 0px -50px 0px' })
  document.querySelectorAll('[data-reveal]').forEach((element) => observer.observe(element))
  mountHeroVideo(document)
</script>

<style>
  .hero { padding-block: var(--space-hero); }
  .music-section, .group-section, .booking-section { padding-block: var(--space-section); }
  .bio-section { padding-block: var(--space-lg); }
  .hero-blurb { max-width: 38rem; font-size: clamp(0.95rem, 2vw, 1.1rem); line-height: 1.6; font-weight: 600; opacity: 0.85; margin: 1rem 0 0; }
  .hero-actions, .music-link { margin-top: 2rem; }
  .music-link { display: inline-block; }
  .videos-heading { margin-top: var(--space-lg); }
  .video-row { display: flex; gap: 1rem; overflow-x: auto; list-style: none; margin: 1rem 0 0; padding: 0 0 0.75rem; scroll-snap-type: x mandatory; }
  .video-row li { flex: 0 0 min(320px, 82vw); scroll-snap-align: start; }
  .video-row a { color: inherit; text-decoration: none; }
  .video-row img { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; margin-bottom: 0.6rem; }
  .video-row span, .music-link, .booking-copy a:not(.btn-primary), .footer-socials a { color: var(--accent); }
  .booking-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-lg); }
  .booking-copy { display: grid; gap: 1.25rem; align-items: start; justify-items: start; }
  .booking-urgency { font-weight: 600; }
  .members-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 2rem; }
  .footer-socials { display: flex; flex-wrap: wrap; gap: 1rem; }
  @media (max-width: 700px) { .booking-grid, .members-grid { grid-template-columns: 1fr; } }
</style>
