---
import MarketingLayout from '../layouts/MarketingLayout.astro'
import Santuario from '../components/Santuario.astro'
import Eyebrow from '../components/Eyebrow.astro'
import { members } from '../data/members'
import { bandSocialUrls } from '../data/socials'
import { loadCatalog } from '../lib/catalog'
import { homeCanonical } from '../lib/publicSiteUrl'

const title = 'Mafia Tumbada — Oficial'
const description = 'Sitio oficial de Mafia Tumbada. Música, videos, integrantes y contacto para contrataciones desde Xalapa, Veracruz.'
const canonicalUrl = homeCanonical(import.meta.env.PUBLIC_SITE_URL, Astro.url.origin)
const catalog = await loadCatalog()
// Piezas de la E (ticket 03): una a la vez, contador 01/N. Música lleva discos y videos.
const musica = [
  ...catalog.releases.map((release) => ({
    titulo: release.title,
    detalle: /^\d{4}$/.test(release.subtitle ?? '') ? release.subtitle : undefined,
    imagen: release.cover,
    href: release.href,
    accion: `Escuchar en ${release.label}`,
  })),
  ...catalog.videos.map((video) => ({
    titulo: video.title,
    detalle: 'Video',
    imagen: video.thumbnail,
    video: true,
    href: video.href,
    accion: 'Ver en YouTube',
  })),
]
const contador = (indice: number, total: number) =>
  `${String(indice + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`
const flechas = { anterior: 'M15 5l-7 7 7 7', siguiente: 'M9 5l7 7-7 7' }
---

<MarketingLayout title={title} description={description} canonicalUrl={canonicalUrl} hasHero={true}>
  <Santuario />

  <section class="seccion hero hero--asymmetric" id="inicio" aria-labelledby="hero-heading">
    <!-- Sale de scripts/build-hero.sh. Vertical en pantallas altas, como la escena. -->
    <video class="hero-video" muted playsinline loop preload="metadata" poster="/video/hero-poster.jpg" aria-hidden="true" data-hero-video>
      <source media="(max-aspect-ratio: 1/1)" src="/video/hero-v.av1.mp4" type='video/mp4; codecs="av01.0.08M.10"' />
      <source media="(max-aspect-ratio: 1/1)" src="/video/hero-v.mp4" type="video/mp4" />
      <source src="/video/hero.av1.mp4" type='video/mp4; codecs="av01.0.08M.10"' />
      <source src="/video/hero.mp4" type="video/mp4" />
    </video>
    <div class="container hero-grid"><div class="hero-copy hero-content">
      <p class="hero-eyebrow">Sitio Oficial</p>
      <h1 id="hero-heading" class="hero-title"><img src="/icon/mafiatumbada.webp" alt="Mafia Tumbada" class="hero-logo-img" width="397" height="264" fetchpriority="high" loading="eager" /></h1>
      <div class="hero-meta"><span>Xalapa, Veracruz</span><span>Corridos Tumbados</span><span>Desde 2021</span></div>
      <div class="hero-actions"><a href={bandSocialUrls.whatsapp} target="_blank" rel="noopener noreferrer" class="btn-primary" data-plausible-event="whatsapp_hero">Escríbenos por WhatsApp</a></div>
    </div></div>
  </section>

  <section class="seccion layout-d" id="quienes" aria-labelledby="bio-heading">
    <div class="velo" aria-hidden="true"></div>
    <div class="bloque" data-panel-scroll>
      <Eyebrow text="Quiénes somos" />
      <h2 id="bio-heading" class="titular gold-text">El sonido de <em>Xalapa</em></h2>
      <p class="linea">La Mafia Tumbada es un grupo de corridos tumbados y regional mexicano con base en Xalapa, Veracruz. Canciones propias, covers con actitud y cuatro años de tarima.</p>
      <div class="acciones">
        <button type="button" class="btn-secondary" data-abrir aria-expanded="false" aria-controls="quienes-mas">Leer más</button>
      </div>
      <div class="mas" id="quienes-mas">
        <div class="bio-tags">{['Corridos Tumbados', 'Norteño', 'Regional Mx', 'Covers', 'Canciones propias'].map((tag) => <span class="tag">{tag}</span>)}</div>
        <div class="bio-body">
          <p>La Mafia Tumbada es un grupo de Xalapa, Veracruz que lleva cuatro años construyendo su propio espacio dentro del regional mexicano contemporáneo. Con raíces en el corrido tumbado y el norteño, y sin perder el pulso del regional clásico, el grupo mezcla canciones propias con covers ejecutados con honestidad y actitud.</p>
          <p>Un catálogo de singles originales es la muestra de un proyecto que toma en serio la composición propia. Al mismo tiempo, su versatilidad en tarima los ha llevado a barras y escenarios tanto en Veracruz como fuera del estado.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="seccion layout-e" id="musica" aria-labelledby="musica-heading" data-pasos>
    <div class="velo" aria-hidden="true"></div>
    <div class="bloque">
      <Eyebrow text="Escucha" />
      <h2 id="musica-heading" class="titular gold-text">Música</h2>
      <ol class="piezas" aria-live="polite">
        {musica.map((pieza, indice) => (
          <li class:list={['pieza', { 'pieza--video': pieza.video }]} data-pieza>
            {pieza.imagen && <img src={pieza.imagen} alt="" width={pieza.video ? 480 : 640} height={pieza.video ? 270 : 640} loading={indice === 0 ? 'eager' : 'lazy'} decoding="async" />}
            <div class="pieza-texto">
              <span class="pieza-contador">{contador(indice, musica.length)}</span>
              <h3>{pieza.titulo}</h3>
              {pieza.detalle && <span class="pieza-detalle">{pieza.detalle}</span>}
              <a class="btn-primary" href={pieza.href} target="_blank" rel="noopener noreferrer">{pieza.accion}</a>
            </div>
          </li>
        ))}
      </ol>
      <div class="controles">
        <button type="button" data-paso="-1" aria-label="Pieza anterior"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d={flechas.anterior} /></svg></button>
        <button type="button" data-paso="1" aria-label="Pieza siguiente"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d={flechas.siguiente} /></svg></button>
        <span class="pista" aria-hidden="true">← → o desliza</span>
      </div>
    </div>
  </section>

  <section class="seccion layout-e" id="grupo" aria-labelledby="grupo-heading" data-pasos>
    <div class="velo" aria-hidden="true"></div>
    <div class="bloque">
      <Eyebrow text="La banda" />
      <h2 id="grupo-heading" class="titular gold-text">El grupo</h2>
      <ol class="piezas" aria-live="polite">
        {members.map((member, indice) => (
          <li class="pieza pieza--retrato" data-pieza>
            <picture>
              <source srcset={member.image.replace('.jpg', '.webp')} type="image/webp" />
              <img src={member.image} alt="" width="1440" height="1081" loading="lazy" decoding="async" />
            </picture>
            <div class="pieza-texto">
              <span class="pieza-contador">{contador(indice, members.length)}</span>
              <h3>{member.name}</h3>
              <span class="pieza-detalle">{member.role}</span>
              <a class="btn-primary" href={member.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
            </div>
          </li>
        ))}
      </ol>
      <div class="controles">
        <button type="button" data-paso="-1" aria-label="Integrante anterior"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d={flechas.anterior} /></svg></button>
        <button type="button" data-paso="1" aria-label="Integrante siguiente"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d={flechas.siguiente} /></svg></button>
        <span class="pista" aria-hidden="true">← → o desliza</span>
      </div>
    </div>
  </section>

  <section class="seccion layout-d" id="contratacion" aria-labelledby="contratacion-heading">
    <div class="velo" aria-hidden="true"></div>
    <div class="bloque" data-panel-scroll>
      <Eyebrow text="Contratar al grupo" />
      <h2 id="contratacion-heading" class="titular gold-text">¿Tienes una <em>fecha disponible?</em></h2>
      <p class="linea">Agenda limitada — los fines de semana suelen reservarse con tres o cuatro semanas de anticipación.</p>
      <div class="acciones">
        <a href={bandSocialUrls.whatsapp} target="_blank" rel="noopener noreferrer" class="btn-primary" data-plausible-event="whatsapp_contratacion">Escríbenos por WhatsApp</a>
        <button type="button" class="btn-secondary" data-abrir aria-expanded="false" aria-controls="contratacion-mas">Leer más</button>
      </div>
      <div class="mas" id="contratacion-mas">
        <p>El grupo está disponible para presentaciones, festivales, eventos privados y giras regionales. Cuentan con equipo propio y experiencia para adaptarse a diferentes formatos de producción.</p>
        <p>O llámanos: <a class="enlace" href="tel:+522283538827">+52 228 353 8827</a></p>
      </div>
    </div>
  </section>

  <footer class="seccion layout-d" id="cierre">
    <div class="velo" aria-hidden="true"></div>
    <div class="bloque">
      <p class="footer-monograma gold-text" aria-hidden="true"><span>M</span><svg class="header-mark-bolt" viewBox="0 0 46 86" focusable="false"><path d="M28 2L6 48h14L16 84l24-48H26L28 2z" fill="currentColor" /></svg><span>T</span></p>
      <span class="footer-brand gold-text">Mafia Tumbada</span>
      <div class="footer-socials">
        <a class="enlace" href={bandSocialUrls.spotify} target="_blank" rel="noopener noreferrer">Spotify</a><a class="enlace" href={bandSocialUrls.appleMusic} target="_blank" rel="noopener noreferrer">Apple Music</a><a class="enlace" href={bandSocialUrls.instagram} target="_blank" rel="noopener noreferrer">Instagram</a><a class="enlace" href={bandSocialUrls.tiktok} target="_blank" rel="noopener noreferrer">TikTok</a><a class="enlace" href={bandSocialUrls.youtube} target="_blank" rel="noopener noreferrer">YouTube</a><a class="enlace" href={bandSocialUrls.whatsapp} target="_blank" rel="noopener noreferrer" data-plausible-event="whatsapp_footer">WhatsApp</a>
      </div>
      <p class="footer-copy">© {new Date().getFullYear()} · Xalapa, Veracruz · Todos los derechos reservados</p>
    </div>
  </footer>
</MarketingLayout>

<script>
  import { trackPlausible } from '../lib/plausibleClient'
  import { montarUi } from '../lib/montarUi'
  montarUi()
  document.querySelectorAll('[data-plausible-event]').forEach((element) => {
    element.addEventListener('click', () => trackPlausible(element.getAttribute('data-plausible-event') ?? ''))
  })
</script>

<style>
  .hero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  /* Velo medido como el de la escena: percentil 95 de luminancia del video detrás
     del texto contra --text a 4.5:1. Móvil pedía 0.44 con el texto arriba; escritorio
     ya pasa sin velo, 0.15 es margen. Con el texto abajo (03) se vuelve a medir en el paso 7. */
  .hero::after { content: ''; position: absolute; inset: 0; background: rgba(0, 0, 0, 0.45); pointer-events: none; }
  @media (min-aspect-ratio: 1/1) { .hero::after { background: rgba(0, 0, 0, 0.15); } }
  .hero-actions { margin-top: 2rem; }
</style>
