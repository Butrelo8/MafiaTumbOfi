---
import { homeCanonical } from '../lib/publicSiteUrl'

const canonical = homeCanonical(import.meta.env.PUBLIC_SITE_URL, Astro.url.origin)
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mafia Tumbada</title>
    <meta name="description" content="Mafia Tumbada. Sitio nuevo en camino." />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <style>
      html, body { margin: 0; height: 100%; background: #000; color: #e8e8e8; }
      body { display: grid; place-items: center; font-family: system-ui, sans-serif; }
      h1 { font-size: clamp(2rem, 8vw, 4rem); margin: 0; text-align: center; }
      p { margin: 0.5rem 0 0; text-align: center; opacity: 0.7; }
    </style>
  </head>
  <body>
    <main>
      <h1>Mafia Tumbada</h1>
      <p>Sitio nuevo en camino.</p>
    </main>
  </body>
</html>
