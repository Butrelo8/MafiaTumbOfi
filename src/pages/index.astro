---
// The home, preview (owner 2026-11-19 01:32; queue 2026-11-19-mto-home-live-scene.md): the live three.js scene with the six montaje
// stop cameras as sections (it was /vivo-secciones, now redirected here), opened by the "MTO" writing and the descent clip. Nav
// clicks and keys move the camera; scroll does not. The truck keeps driving the whole time. The video home is /anterior-home.
import '@fontsource/archivo/400.css'
import '@fontsource/archivo/600.css'
import Apertura from '../components/Apertura.astro'
// stop 4 (owner 19:11): one shot per member, a second row of buttons while it is the stop
const banda = ['Manager', 'Héctor', 'Alejandro', 'Diego']
const paradas = [
  ['cabina', 'Cabina'], ['caja', 'Caja'], ['pantalla', 'Pantalla'], ['banda', 'Banda'], ['gira', 'Gira'], ['placa', 'Placa'],
]
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>En vivo por secciones · Mafia Tumbada</title>
  <style>
    :root {
      --bg: oklch(7% 0 0); --text: oklch(95% 0.008 85); --muted: oklch(82% 0.008 85);
      --gold: oklch(78% 0.15 85); --focus-ring: oklch(78% 0.15 85 / 0.7); --panel: oklch(7% 0 0 / 0.72);
    }
    html, body { margin: 0; height: 100%; background: var(--bg); color: var(--text); font: 400 16px/1.5 'Archivo', system-ui, sans-serif; overflow: hidden; }
    #lienzo, #respaldo { position: fixed; inset: 0; width: 100vw; height: 100dvh; display: block; object-fit: cover; }
    #respaldo { z-index: 0; }
    #lienzo { z-index: 1; opacity: 0; transition: opacity 0.6s; }
    #lienzo.listo { opacity: 1; }
    nav { position: fixed; z-index: 2; left: 50%; bottom: max(16px, env(safe-area-inset-bottom)); transform: translateX(-50%);
      display: flex; gap: 4px; padding: 4px; background: var(--panel); border-radius: 999px; max-width: calc(100vw - 32px); overflow-x: auto; }
    nav button { min-height: 44px; min-width: 44px; padding: 0 16px; border: 0; border-radius: 999px; background: none;
      color: var(--muted); font: 600 15px/1 'Archivo', system-ui, sans-serif; cursor: pointer; white-space: nowrap; }
    nav button[aria-current='true'] { background: var(--gold); color: oklch(12% 0 0); }
    nav button:focus-visible { outline: 3px solid var(--focus-ring); outline-offset: 2px; }
    nav#banda { bottom: calc(max(16px, env(safe-area-inset-bottom)) + 60px); }
    nav[hidden] { display: none; }
    h1 { position: fixed; z-index: 2; left: 16px; top: 12px; margin: 0; font-size: 15px; font-weight: 600; color: var(--muted); }
    #creditos { position: fixed; z-index: 2; right: 16px; top: 12px; margin: 0; max-width: 46ch; font-size: 11px; color: var(--muted); text-align: right; }
    #creditos a { color: inherit; }
    @media (max-width: 600px) { nav button { padding: 0 10px; font-size: 14px; } #creditos { display: none; } }
    @media (prefers-reduced-motion: reduce) { #lienzo { transition: none; } }
  </style>
</head>
<body>
  <Apertura />
  <h1>Mafia Tumbada · en vivo</h1>
  <img id="respaldo" src="/prototipo/parada-1.webp" alt="" aria-hidden="true" />
  <canvas id="lienzo" role="img" aria-label="La troca de Mafia Tumbada rodando de noche por la carretera, con la banda adentro"></canvas>
  <nav id="escenas" aria-label="Escenas">
    {paradas.map(([id, label], i) => (
      <button type="button" data-parada={i} aria-current={i === 0 ? 'true' : 'false'} id={'p-' + id}>{label}</button>
    ))}
  </nav>
  <nav id="banda" aria-label="La banda" hidden>
    {banda.map((label, i) => (
      <button type="button" data-toma={i} aria-current={i === 0 ? 'true' : 'false'}>{label}</button>
    ))}
  </nav>
  <p id="creditos">Modelos: «Mitsubishi Fuso Canter» de Raed Almaharmah (CC BY 4.0, modificado),
    autos low-poly de Quaternius (CC0).</p>
  <script>
    import { arrancar } from '../scripts/vivoSecciones'
    import { trackPageview } from '../lib/clickEvents'
    trackPageview(document)
    arrancar()
  </script>
</body>
</html>
