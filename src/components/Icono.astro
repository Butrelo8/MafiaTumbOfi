---
// Working icons (DESIGN.md › Components). The buttons-icons pair chain replaces this file with morphing icons;
// keep the props (nombre, clase) so Boton.astro and the page don't change.
interface Props {
  nombre: 'play'
  clase?: string
}
const { nombre, clase } = Astro.props
const trazos = { play: 'M6 4l14 8-14 8z' }
---

<svg class:list={['icono', clase]} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d={trazos[nombre]} /></svg>
