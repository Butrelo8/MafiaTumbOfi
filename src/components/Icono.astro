---
// Iconos de DESIGN.md › Components. play y pausa comparten estructura de puntos (src/lib/formas.ts) para que el interruptor
// del loop los transforme con GSAP MorphSVG (src/scripts/loop.ts). Siempre decorativos: el nombre lo da la etiqueta.
import { FORMAS, type Forma } from '../lib/formas'
interface Props {
  nombre: Forma
  clase?: string
}
const { nombre, clase } = Astro.props
---

<svg class:list={['icono', clase]} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d={FORMAS[nombre]} /></svg>
