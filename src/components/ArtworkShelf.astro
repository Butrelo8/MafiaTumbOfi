---
export interface ShelfItem {
  title: string
  subtitle?: string
  href: string
  label: string
  cover?: string
}
interface Props {
  items: ShelfItem[]
}
const { items } = Astro.props

// Brand marks keyed by the destination host, not the label: labels are prose
// ("Escuchar en Spotify") and could be reworded. Same paths the header uses.
