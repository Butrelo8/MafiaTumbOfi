---
/**
 * Intro de la primera visita (2026-10-14, variante A "Rayo", elegida por el usuario sobre "Firma"): el rayo rojo se
 * traza y M y T entran de los lados, en la caja del logo del hero; luego la capa se va y deja ver el hero. Sólo
 * transform, opacity y stroke-dashoffset: animar filtros le costó cuadros al video del hero. Nunca bloquea: sale en
 * cuanto la marca está completa (0.85 s) y el video del hero puede reproducirse entero, y a los 1.5 s pase lo que pase;
 * sin JS, la CSS la quita a los 2 s. El video del hero no corre debajo: empieza al irse la capa (montarSantuario).
 * Sólo la primera vez por sesión, entrando por `/` (sin ancla) y nunca con movimiento reducido.
 * M y T son los contornos de Pirata One (fonttools); el rayo, el del encabezado.
 */
---
<script is:inline>
  try {
    if (!location.hash && !matchMedia('(prefers-reduced-motion: reduce)').matches && !sessionStorage.getItem('mt-intro')) {
      sessionStorage.setItem('mt-intro', '1')
      document.documentElement.classList.add('intro', 'con-intro')
    }
  } catch {}
</script>
<div class="intro-capa" data-intro aria-hidden="true">
  <svg viewBox="0 0 1420 820" focusable="false">
    <g class="intro-m"><path transform="translate(10 780) scale(1 -1)" d="M50 102V607Q50 640 36.0 664.0Q22 688 1 688V710Q8 711 110 771Q117 769 127.0 765.5Q137 762 153.5 746.0Q170 730 170 709Q176 712 204 728Q278 770 295.5 770.0Q313 770 334.5 752.0Q356 734 367 709Q369 710 408 730Q486 770 502 770Q534 770 562.0 728.0Q590 686 590 651V148Q590 93 639 83V61L530 0Q508 9 489.0 29.5Q470 50 470 68V558Q470 618 450.5 641.5Q431 665 380 667V148Q380 93 429 83V61L320 0Q298 9 279.0 29.5Q260 50 260 68V558Q260 621 241.5 644.0Q223 667 170 667V154Q170 117 178.0 101.0Q186 85 211 85V54L6 -32L-10 0Q12 0 32 26Q50 51 50 102Z" /></g>
    <g class="intro-rayo"><path pathLength="1" transform="translate(590 10) scale(9.3)" d="M28 2L6 48h14L16 84l24-48H26L28 2z" /></g>
    <g class="intro-t"><path transform="translate(990 780) scale(1 -1)" d="M122 102V632L153 662H90Q29 662 21 629H-1L-58 711Q-46 730 -27.0 745.0Q-8 760 10 760H274Q335 760 343 793H365L422 711Q410 692 391.0 677.0Q372 662 354 662H242V154Q242 117 250.0 101.0Q258 85 283 85V54L78 -32L62 0Q84 0 104 26Q122 51 122 102Z" /></g>
  </svg>
</div>
<script>
  const raiz = document.documentElement
  const capa = document.querySelector<HTMLElement>('[data-intro]')
  if (capa && raiz.classList.contains('intro')) {
    const marca = capa.querySelector('svg')!
    const logo = document.querySelector('.hero-logo-img')?.getBoundingClientRect()
    if (logo && logo.width > 0) {
      const alto = (logo.width * 820) / 1420
      marca.style.left = `${logo.left}px`
      marca.style.top = `${logo.top + (logo.height - alto) / 2}px`
      marca.style.width = `${logo.width}px`
    }
    capa.classList.add('anda')
    const video = document.querySelector<HTMLVideoElement>('[data-hero-video]')
    if (video) video.preload = 'auto'
    const espera = (ms: number) => new Promise((ok) => setTimeout(ok, ms))
    const puede = new Promise((ok) => {
      if (!video || video.readyState >= 4) ok(null)
      else video.addEventListener('canplaythrough', ok, { once: true })
    })
    Promise.race([Promise.all([puede, espera(850)]), espera(1500)]).then(() => {
      raiz.classList.add('intro-sale')
      setTimeout(() => {  // el fundido de la capa dura 0.25 s; un temporizador, no transitionend: en una pestaña oculta no llega
        raiz.classList.remove('intro', 'intro-sale')
        document.dispatchEvent(new Event('santuario:intro-fin'))
      }, 260)
    })
  }
</script>
<style is:global>
  .intro-capa { display: none; }
  html.intro .intro-capa {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: var(--bg);
    pointer-events: none;
    transition: opacity 0.25s ease;
    animation: intro-fuera 0.25s 2s forwards; /* sin JS, o si algo falla */
  }
  html.intro-sale .intro-capa { opacity: 0; }
  /* El fundido de la capa es la entrada del hero: sin el fadeUp de su texto (y la caja del logo se mide quieta). */
  html.con-intro .hero-eyebrow,
  html.con-intro .hero-title,
  html.con-intro .hero-meta { animation: none; }

  .intro-capa svg { position: absolute; left: 8vw; top: 55svh; width: min(320px, 55vw); overflow: visible; }
  .intro-m path, .intro-t path { fill: var(--gold); }
  .intro-rayo path { fill: var(--red); fill-opacity: 0; stroke: var(--red); stroke-width: 1; stroke-dasharray: 1; stroke-dashoffset: 1; }
  .intro-m, .intro-t { opacity: 0; }
  .intro-m { transform: translateX(-280px); }
  .intro-t { transform: translateX(280px); }
  .anda .intro-rayo path { animation: intro-trazo 0.45s ease-out forwards, intro-llenar 0.2s 0.4s forwards; }
  .anda .intro-m { animation: intro-entra 0.5s 0.3s cubic-bezier(0.2, 0.7, 0.2, 1) forwards; }
  .anda .intro-t { animation: intro-entra 0.5s 0.35s cubic-bezier(0.2, 0.7, 0.2, 1) forwards; }
  @keyframes intro-trazo { to { stroke-dashoffset: 0; } }
  @keyframes intro-llenar { to { fill-opacity: 1; } }
  @keyframes intro-entra { to { opacity: 1; transform: none; } }
  @keyframes intro-fuera { to { opacity: 0; visibility: hidden; } }
</style>
