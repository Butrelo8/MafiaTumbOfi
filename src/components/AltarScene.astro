---
/**
 * Fondo del santuario: el canvas que el scroll recorre.
 *
 * Debajo va el frame de la primera estación como <img>: es el LCP y a la vez
 * el fallback si el navegador no decodifica AVIF o si falla el script.
 */
import escena from '../data/scene.json'

const movil = escena.formatos.mobile
const escritorio = escena.formatos.desktop
const primeraMovil = movil?.estaciones[0]
const primeraEscritorio = escritorio?.estaciones[0]
---

{primeraMovil && (
  <div class="altar-escena" aria-hidden="true">
    <picture>
      <source media="(min-aspect-ratio: 1/1)" srcset={primeraEscritorio?.imagen} />
      <img
        class="altar-escena__lcp"
        src={primeraMovil.imagen}
        alt=""
        width={movil.ancho}
        height={movil.alto}
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <canvas class="altar-escena__canvas" data-altar-canvas></canvas>
    <div class="altar-escena__velo"></div>
  </div>
)}

{primeraMovil && (
  <div class="altar-frente" aria-hidden="true">
    {movil.estaciones.map((estacion, indice) => (
      estacion.capaFrente && (
        <picture>
          {escritorio?.estaciones[indice]?.capaFrente && (
            <source
              media="(min-aspect-ratio: 1/1)"
              srcset={escritorio.estaciones[indice].capaFrente.imagen}
            />
          )}
          <img
            data-capa-frente={indice}
            src={estacion.capaFrente.imagen}
            alt=""
            loading="lazy"
            decoding="async"
          />
        </picture>
      )
    ))}
  </div>
)}

<style>
  .altar-escena {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: #000;
  }

  .altar-escena__lcp,
  .altar-escena__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Velo: la escena está iluminada y el texto va encima. El 0.62 está medido,
     no elegido a ojo: es el alfa mínimo con el que el percentil 95 de la
     estación más brillante (la reliquia, cromo del micro) sigue dando 4.5:1
     contra --text. Bajarlo rompe AA; ver docs/blender-notas.md. */
  .altar-escena {
    --velo: 0.62;
  }

  .altar-escena__velo {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, var(--velo));
  }

  /* La capa de frente va por ENCIMA del texto, o sea por encima del velo, así
     que saldría a brillo completo sobre una escena atenuada y se vería como un
     recorte pegado. Tapar con negro al 0.62 es multiplicar por 0.38, y eso es
     exactamente lo que hace `brightness`: mismo velo, y respeta el alfa.
     El número no se repite: se calcula del mismo sitio. */
  .altar-frente {
    --velo: 0.62;
    position: fixed;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .altar-frente img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    filter: brightness(calc(1 - var(--velo)));
  }

  /* El vídeo del hero es un fondo decorativo y tapaba la escena entera. Se
     apaga, no se borra: el marcado sigue ahí. */
  :global(.hero-video) {
    display: none;
  }

  /* Los velos del hero existían para que el texto se leyera sobre ese vídeo.
     Con la escena detrás sobran: el ::before lo tapaba de negro y el ::after
     metía un halo rojo que se leía como una banda. La legibilidad ya la da el
     velo medido de arriba. */
  :global(.hero::before) {
    background-image: none;
  }

  :global(.hero::after) {
    box-shadow: none;
  }

  /* Cada sección de estación ocupa al menos una ventana: así el tramo entre
     dos estaciones tiene un recorrido de scroll parecido y la cámara no
     atraviesa veinte frames en 600 px en unas secciones y en 1700 en otras.
     Sólo crece las cortas; la de música ya es más alta que esto. */
  :global([data-estacion]) {
    min-height: 100svh;
  }

  /* Espacio de viaje: los tramos hornacinas->reliquia y reliquia->retirada
     tenian 900 px de scroll para veinte frames, contra 2005 del tramo de
     Musica, y la camara iba al doble de velocidad en la segunda mitad. Esto no
     es relleno: es el recorrido entre dos estaciones, sin nada que leer. */
  :global(.tramo-espacio) {
    height: 50svh;
  }

  /* La escena vive DENTRO de <main>, así que subir <main> no basta: dentro de
     su propio contexto de apilado, un elemento posicionado con z-index 0 pinta
     por encima del texto en flujo, que no está posicionado. El hero se salvaba
     sólo porque es `position: relative` y va después en el DOM; el resto de las
     secciones son estáticas y quedaban tapadas por el canvas. Hay que subirlas
     explícitamente. */
  :global(.marketing-main > *:not(.altar-escena)) {
    position: relative;
    z-index: 1;
  }

  /* El contenido va encima de la escena: el fondo del body es opaco, así que
     la escena no puede ir a z-index negativo. */
  :global(.marketing-main),
  :global(.site-header),
  :global(.site-footer),
  :global(.mobile-menu) {
    position: relative;
    z-index: 1;
  }

  /* El canvas tapa al <img> en cuanto pinta su primer frame. */
  .altar-escena__canvas {
    opacity: 0;
    transition: opacity 240ms ease;
  }

  .altar-escena__canvas[data-frame] {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .altar-escena__canvas {
      transition: none;
    }
  }
</style>

<script>
  import escena from '../data/scene.json'
  import { formatoParaPantalla, framesDeEstacion, mountScrollScene } from '../lib/scrollScene'
  import { montarCapas } from '../lib/capasEstacion'

  const canvas = document.querySelector<HTMLCanvasElement>('[data-altar-canvas]')
  if (canvas) {
    const clave = formatoParaPantalla(escena, window.innerWidth, window.innerHeight)
    const formato = escena.formatos[clave]
    const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    // Un solo lector del scroll: `scrollScene` avisa del frame y las capas se
    // cuelgan de ese aviso. Dos escuchas del mismo evento se desincronizan.
    const pintarCapas = formato
      ? montarCapas({
          formato,
          framesDeEstacion: framesDeEstacion(formato),
          documento: document,
          sinMovimiento,
        })
      : () => {}
    mountScrollScene({ canvas, escena, alCambiarFrame: pintarCapas })
  }
</script>
