---
const line =
  Astro.props.text ??
  'CORRIDOS TUMBADOS · XALAPA · DESDE 2021 · CORRIDOS TUMBADOS · XALAPA · DESDE 2021 · '

// ponytail: the -50% scroll is seamless only while half the track is wider than
// the viewport. 8 copies covers past 4K; bump the count if it ever gaps.
const copies = Array.from({ length: 8 }, (_, i) => i)
---

<div class="marquee-wrap" role="presentation" aria-hidden="true">
  <div class="marquee-track">
    {copies.map(() => <span class="marquee-text">{line}</span>)}
  </div>
</div>
