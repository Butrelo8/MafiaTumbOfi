---
// Working button: square, gold edge; the fill wipes up from the bottom like a dash light coming on, the press dips 2 px
// (references.md › botones: rafadesign wipe, boleto press). The buttons-icons pair chain replaces this file; keep the
// props (href, lleno, icono) so the page doesn't change.
import Icono from './Icono.astro'

interface Props {
  href: string
  lleno?: boolean
  icono?: 'play'
  id?: string
}
const { href, lleno = false, icono, id } = Astro.props
---

<a class:list={['boton', { lleno }]} href={href} id={id}>
  {icono && <Icono nombre={icono} />}
  <slot />
</a>

<style>
  .boton {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 22px;
    border: 2px solid var(--gold);
    color: var(--ink);
    text-decoration: none;
    font: 600 16px/1 Saira, sans-serif;
    overflow: hidden;
    isolation: isolate;
    transition: transform 90ms, color 500ms cubic-bezier(0.65, 0, 0.35, 1);
  }
  .boton::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--gold);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 500ms cubic-bezier(0.65, 0, 0.35, 1);
  }
  .boton:hover::before,
  .boton:focus-visible::before,
  .lleno::before {
    transform: scaleY(1);
  }
  .boton:hover,
  .boton:focus-visible,
  .lleno {
    color: var(--bg);
  }
  .boton:active {
    transform: translateY(2px);
  }
  .boton :global(.icono) {
    width: 18px;
    height: 18px;
  }
  @media (prefers-reduced-motion: reduce) {
    .boton,
    .boton::before {
      transition: none;
    }
  }
</style>
