{
  "name": "mafiatumbada",
  "compatibility_date": "2026-09-08",
  "main": "worker.js",
  "workers_dev": true,
  "routes": [
    { "pattern": "mafiatumbada.com", "custom_domain": true },
    { "pattern": "www.mafiatumbada.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Workers Static Assets ignora Range; worker.js lo resuelve para el video del hero. Todo lo
    // demás (HTML, JS, CSS, imágenes) se sirve directo desde los assets sin invocar al Worker.
    "run_worker_first": ["/video/*"]
  }
}
